# Server
PORT=3000
DATA_DIR=".data"

# Lead discovery
# Keep the default for light development usage or point this at your own
# Overpass instance for regular/production traffic.
# Virgülle ayırarak kendi/yedek Overpass örneklerinizi ekleyebilirsiniz.
OVERPASS_API_URLS="https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter"
DISCOVERY_CACHE_TTL_MINUTES=30
ADMIN_CONTACT_EMAIL=""

# Comma-separated host names allowed for live website audits even if DNS
# resolution cannot be checked. Leave empty in production.
AUDIT_HOST_ALLOWLIST=""
